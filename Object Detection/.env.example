# All variables are OPTIONAL. The production pipeline runs with no .env file —
# the defaults below match the in-code defaults of server/config.py.

# --- Production server (optional overrides) -----------------------------------
# ROSHDI_OD_WEIGHTS_PATH=yolo11n.pt          # auto-downloaded if missing
# ROSHDI_OD_DEVICE=auto                      # auto | cpu | cuda | mps
# ROSHDI_OD_IMGSZ=640
# ROSHDI_OD_CONF_THRESHOLD=0.25
# ROSHDI_OD_IOU_THRESHOLD=0.45
# ROSHDI_OD_INFERENCE_TIMEOUT_S=5.0
# ROSHDI_OD_MAX_IMAGE_BYTES=8388608
# ROSHDI_OD_LOG_LEVEL=INFO
# ROSHDI_OD_API_KEY=set-me-to-require-auth-on-/v1/

# --- Optional fine-tuning (only needed for train.py / download_dataset.py) ----
# ROBOFLOW_API_KEY=your_roboflow_api_key_here
# ROBOFLOW_WORKSPACE=microsoft
# ROBOFLOW_PROJECT=coco
# ROBOFLOW_VERSION=50
